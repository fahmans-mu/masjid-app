# Salin file ini menjadi .env lalu isi nilainya.
# AUTH_SECRET: teks acak panjang (minimal 32 karakter) untuk mengamankan sesi login.
AUTH_SECRET=ganti-dengan-teks-acak-panjang-anda
# Ubah ke true kalau situs sudah diakses via HTTPS.
COOKIE_SECURE=false
# Opsional: URL publik aplikasi, dipakai untuk redirect & URL webhook Mayar.
# APP_URL=https://masjid-app.my.id
# Opsional: base URL API Mayar. Default produksi https://api.mayar.id/hl/v2
# Gunakan https://api.mayar.club/hl/v2 untuk sandbox.
# MAYAR_API_BASE=https://api.mayar.id/hl/v2
